{
  "name": "nexora-frontend",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run routes:generate && vite build && tsc -b",
    "preview": "vite preview",
    "typecheck": "npm run routes:generate && tsc --noEmit -p tsconfig.app.json",
    "api:generate": "node scripts/generate-api.mjs",
    "api:generate:official": "node scripts/prepare-openapi.mjs && npx @rtk-query/codegen-openapi openapi.config.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node scripts/prepare-hooks.mjs",
    "lint:fix": "eslint . --fix",
    "check": "npm run api:check && npm run check:architecture && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "api:check": "node scripts/check-contract.mjs",
    "routes:generate": "tsr generate",
    "check:architecture": "node scripts/check-architecture.mjs",
    "smoke:demo": "node scripts/smoke-demo.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.9.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-router": "^1.168.48",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-redux": "^9.2.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.0",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  },
  "description": "Role-aware electronics storefront and StoreOwner console built from ECommerce OpenAPI"
}
