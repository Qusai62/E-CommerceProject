# Set false to connect to your real ASP.NET Core API.
VITE_DEMO_MODE=true
# Browser requests use /api on the same origin; Vite proxies to this backend in development.
API_PROXY_TARGET=https://localhost:7162
# ASP.NET antiforgery bootstrap endpoint. Change this only if your controller route differs.
VITE_CSRF_ENDPOINT=/api/security/csrf
# Optional public CDN base for product storage keys. Do not configure this as a secret.
VITE_IMAGE_BASE_URL=
# Replace when backend defines prices/currency; Swagger does not declare currency.
VITE_CURRENCY=JOD

# Fail closed for real order submissions until you verify PaymentMethod enum 1/2 labels in C#.
VITE_PAYMENT_METHODS_VERIFIED=false
