{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "skipLibCheck": true,
    "allowImportingTsExtensions": true, "resolveJsonModule": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "noEmit": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "baseUrl": ".", "paths": { "@/*": ["./src/*"] }, "types": ["vite/client"]
  },
  "include": ["src"]
}
